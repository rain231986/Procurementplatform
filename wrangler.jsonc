{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "pharmaflow-phase1",
	"main": "./worker/index.js",
	"compatibility_date": "2026-07-29",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pharmaflow-phase1",
			"migrations_dir": "worker/migrations",
			"database_id": "243563c2-3dbe-48b7-aa83-ab06b596c622"
		}
	],
	"vars": {
		"APP_ENV": "preview"
	}
}